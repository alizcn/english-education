"sırayla ilerlersiniz."
msgstr ""

#: apps/dashboard/faq.py:52
msgid "Yanlış yaptığım kelimeler ne oluyor?"
msgstr ""

#: apps/dashboard/faq.py:53
msgid ""
"Yanlış cevapladığınız kelimeler otomatik olarak tekrar havuzuna eklenir ve "
"ileriki sorularda karşınıza çıkar. Doğru cevaplayana kadar peşinizi bırakmaz."
msgstr ""

#: apps/dashboard/faq.py:58
msgid "Kendi kelimelerimi ekleyebilir miyim?"
msgstr ""

#: apps/dashboard/faq.py:59
msgid ""
"Evet. Kelimelerim bölümünden istediğiniz kelimeleri girebilirsiniz. AI "
"otomatik olarak anlamını ve örnek cümlesini üretir."
msgstr ""

#: apps/dashboard/faq.py:63
msgid "AI Chat ne işe yarar?"
msgstr ""

#: apps/dashboard/faq.py:64
