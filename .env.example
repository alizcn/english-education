# --- Claude ---
# cli = ~/.claude oturumu (Pro/Max aboneliği, API key gerekmez)
# api = ANTHROPIC_API_KEY ile token başına faturalandırma
CLAUDE_AUTH_MODE=cli
# Boş bırakılırsa claude binary'si PATH'te aranır
CLAUDE_CLI_PATH=
# Subprocess başına duvar saati sınırı. Gunicorn --timeout bunun üstünde olmalı.
CLAUDE_CLI_TIMEOUT=600
# Yalnızca CLAUDE_AUTH_MODE=api iken gerekli
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Üretim çağrılarının token tavanı (düşünme blokları da buradan harcanır)
CLAUDE_MAX_TOKENS=16000
CLAUDE_CHAT_MAX_TOKENS=4000
# low | medium | high | xhigh | max — boş bırakılırsa parametre gönderilmez.
# Haiku 4.5 effort'u KABUL ETMİYOR; bu yüzden boş. Opus/Sonnet'te doldurulabilir.
CLAUDE_REASONING_EFFORT=
# adaptive | disabled — boş bırakılırsa parametre gönderilmez (düşünme kapalı).
# adaptive/disabled sadece Opus 4.6+ ve Sonnet 4.6+ için; Haiku 4.5'te boş kalmalı.
CLAUDE_THINKING=
CLAUDE_MAX_RETRIES=3
# Uzun uretimler kac paralel parcaya bolunsun. BELLEK sinirli: cli modunda her
# parca ayri bir Claude Code subprocess'i (~220-400 MB) ve celery concurrency ile
# carpilir. 5'ten fazlasi olcumde hiz kazandirmiyor.
CLAUDE_MAX_PARALLEL=5

# --- SEO ---
# Canonical/OG/sitemap URL'lerinin kökü (şema dahil, sonda / olmadan)
SITE_URL=https://levelenai.com
# Google Search Console doğrulama kodu (boşsa meta etiketi basılmaz)
GOOGLE_SITE_VERIFICATION=
# GA4 ölçüm kimliği, örn. G-XXXXXXXXXX (boşsa gtag hiç yüklenmez)
GA_MEASUREMENT_ID=
