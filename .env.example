# CLI auth whitelist (opsiyonel, virgulle ayrilmis GitHub usernames).
# Buradaki kullanicilar host'tan mount edilen ~/.claude auth'unu kullanir,
# kendi Anthropic API key'lerini girmek zorunda degillerdir. Bos birakilabilir.
CLAUDE_CLI_AUTH_USERS=

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1200

# --- SEO ---
# Canonical/OG/sitemap URL'lerinin kökü (şema dahil, sonda / olmadan)
SITE_URL=https://levelenai.com
# Google Search Console doğrulama kodu (boşsa meta etiketi basılmaz)
GOOGLE_SITE_VERIFICATION=
# GA4 ölçüm kimliği, örn. G-XXXXXXXXXX (boşsa gtag hiç yüklenmez)
GA_MEASUREMENT_ID=
